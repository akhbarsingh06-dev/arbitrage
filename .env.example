# ═══════════════════════════════════════════════
#  BASE ARBITRAGE PROTOCOL — Environment Config
# ═══════════════════════════════════════════════

# Deployer private key (NEVER commit this!)
# Format: 0x + 64 hex chars
DEPLOYER_PRIVATE_KEY=

# Base RPC URLs (free public endpoints)
BASE_RPC_URL=https://mainnet.base.org
# Optional: comma-separated fallback RPCs (all must be free/public)
# NOTE: Only add endpoints you can actually resolve/reach from your machine.
# BASE_RPC_URLS=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Optional WebSocket URL (leave blank to use polling; avoids paid WS providers)
BASE_WS_URL=
# Optional: comma-separated websocket RPCs (must be free/public)
# BASE_WS_URLS=wss://your-free-ws-endpoint

# BaseScan API key (free) for contract verification
BASESCAN_API_KEY=your_basescan_api_key

# Contract Addresses (populate after deployment)
TREASURY_ADDRESS=
RISK_MANAGER_ADDRESS=
ARBITRAGE_ROUTER_ADDRESS=
FLASH_LOAN_EXECUTOR_ADDRESS=
UNISWAP_V3_ADAPTER_ADDRESS=
PANCAKESWAP_V3_ADAPTER_ADDRESS=
AERODROME_ADAPTER_ADDRESS=

# External Protocol Addresses (Base Mainnet)
# Note: For Base Sepolia, set these to the Sepolia equivalents before running `npm -C contracts run deploy:base-sepolia`.
# If Aave is not available on the target network, you may set `AAVE_POOL=0x0000000000000000000000000000000000000000` and use UniV3 flash fallback where applicable.
AAVE_POOL=0xA238Dd80C259a72e81d7e4664a9801593F98d1c5
UNISWAP_V3_ROUTER=0x2626664c2603336E57B271c5C0b26F421741e481
# Uniswap v3 Quoter on Base:
# Prefer Uniswap's official View Quoter (returns normally; avoids revert-data issues on public RPCs).
UNISWAP_V3_QUOTER=0x222ca98f00ed15b1fae10b61c277703a194cf5d2
UNISWAP_V3_FACTORY=0x33128a8fC17869897dcE68Ed026d694621f6FDfD
# PancakeSwap v3 on Base
PANCAKESWAP_V3_ROUTER=0x1b81D678ffb9C0263b24A97847620C99d213eB14
PANCAKESWAP_V3_QUOTER=0xB048Bbc1Ee6b733FFfCFb9e9CeF7375518e25997
PANCAKESWAP_V3_FACTORY=0x0BFbCF9fa4f9C56B0F40a671Ad40E0805A091865
AERODROME_ROUTER=0xcF77a3Ba9A5CA399B7c97c74d54e5b1Beb874E43

# Token Addresses (Base Mainnet)
WETH_ADDRESS=0x4200000000000000000000000000000000000006
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
CBETH_ADDRESS=0x2Ae3F1Ec7F1F5012CFEab0185bfc7aa3cf0DEc22
DAI_ADDRESS=0x50c5725949A6F0c72E6C4a641F24049A917DB0Cb
USDBC_ADDRESS=0xd9aAEc86B65D86f6A7B5B1b0c42FFA531710b6CA
CBBTC_ADDRESS=0xcbB7C0000aB88B473b1f5aFd9ef808440eed33Bf

# Backend Configuration
# Relayer private key used by backend to submit transactions.
# Format: 0x + 64 hex chars
RELAYER_PRIVATE_KEY=
# Optional: dedicated relayer address to grant RELAYER_ROLE during deploy (if not set, deployer/RELAYER_PRIVATE_KEY will be used)
RELAYER_ADDRESS=
# Minimum relayer balance required before submitting transactions (Base gas is cheap)
MIN_RELAYER_BALANCE_ETH=0.001
SCAN_INTERVAL_MS=5000
MIN_PROFIT_USD=1.0
# Additional cushion on top of MIN_PROFIT_USD
PROFIT_BUFFER_USD=0.25
# Minimum cross-DEX net spread (%) before running expensive simulations
MIN_SPREAD_PERCENT=0.05
MAX_GAS_PRICE_GWEI=50
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
# Bind host for the backend API server (use 0.0.0.0 in containers)
HOST=127.0.0.1

# High-liquidity pool filters (optional)
# MIN_UNIV3_LIQUIDITY=0
# MIN_RESERVE_USDC=250000
# MIN_RESERVE_WETH=50
# MIN_RESERVE_CBETH=50
# MIN_RESERVE_DAI=250000
# MIN_RESERVE_USDBC=250000
# MIN_RESERVE_CBBTC=2

# Optional extra tokens/pairs (JSON) for adding 1-2 stablecoin pairs later
# EXTRA_TOKENS_JSON=[{"address":"0x...","decimals":18,"symbol":"SOME"}]
# EXTRA_PAIRS_JSON=[{"name":"USDC/SOME","token0":"0x...","token1":"0x...","v3Pools":[{"dex":"uniswapV3","fee":100}],"aerodromePools":[{"stable":true}]}]

# Frontend
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_FLASH_LOAN_EXECUTOR_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
NEXT_PUBLIC_WETH_ADDRESS=0x4200000000000000000000000000000000000006
NEXT_PUBLIC_CBETH_ADDRESS=0x2Ae3F1Ec7F1F5012CFEab0185bfc7aa3cf0DEc22
NEXT_PUBLIC_DAI_ADDRESS=0x50c5725949A6F0c72E6C4a641F24049A917DB0Cb
NEXT_PUBLIC_USDBC_ADDRESS=0xd9aAEc86B65D86f6A7B5B1b0c42FFA531710b6CA
NEXT_PUBLIC_CBBTC_ADDRESS=0xcbB7C0000aB88B473b1f5aFd9ef808440eed33Bf

# Hardhat
FORK_ENABLED=false
REPORT_GAS=false

# RPC healthcheck (backend)
# If you added multiple RPC URLs, backend will automatically filter out the unhealthy ones.
RPC_HEALTHCHECK_TIMEOUT_MS=1500
# SKIP_RPC_HEALTHCHECK=true
